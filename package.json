{
  "name": "agental-sdk",
  "version": "0.4.0",
  "description": "TypeScript SDK for agental.io: Linux sandboxes for your agents. The agental command is the package agental.",
  "license": "MIT",
  "author": "VERTIXER LTD",
  "homepage": "https://agental.io",
  "bugs": {
    "url": "https://github.com/agental-io/agental-typescript/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/agental-io/agental-typescript.git"
  },
  "type": "module",
  "engines": {
    "node": ">=20.16"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && npm run build"
  },
  "keywords": [
    "agental",
    "agents",
    "sandbox",
    "ssh",
    "virtual-machine"
  ],
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
